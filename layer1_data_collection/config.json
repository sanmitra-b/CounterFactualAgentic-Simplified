{
  "sources": {
    "news": {
      "enabled": true,
      "methods": {
        "newsapi": {
          "enabled": true,
          "api_key": "3eca2036c90a426e9513d8b04ec70599",
          "note": "NewsAPI for AI workforce and job-risk news"
        },
        "rss": {
          "enabled": true,
          "feeds": [
            "https://www.technologyreview.com/feed/",
            "https://www.theverge.com/rss/index.xml",
            "https://feeds.arstechnica.com/arstechnica/index",
            "https://www.wired.com/feed/rss",
            "https://rss.nytimes.com/services/xml/rss/nyt/Technology.xml",
            "https://arxiv.org/rss/cs.AI",
            "https://huggingface.co/blog/feed.xml"
          ]
        }
      },
      "keywords": [
        "AI job displacement",
        "automation layoffs",
        "generative AI workforce impact",
        "AI hiring trends",
        "reskilling for AI",
        "job cuts technology"
      ],
      "max_results_per_source": 50
    },
    "financial": {
      "enabled": true,
      "alpha_vantage": {
        "enabled": true,
        "api_key": "N4JMB7XG63V126PM",
        "outputsize": "compact",
        "tickers": ["MSFT", "GOOGL", "AMZN", "META", "NVDA", "ADBE"],
        "note": "AI economy and labor-market proxy equities (compact mode for free tier)",
        "rate_limit_seconds": 1.5
      },

      "fred": {
        "enabled": true,
        "api_key": "2027ed85461b99f7e41641fa767602f9",
        "indicators": ["UNRATE", "ICSA", "PAYEMS", "JTSJOL"],
        "note": "US labor market indicators from FRED (LNS13000000 removed - invalid series)"
      }
    },
    "jobs": {
      "enabled": true,
      "usajobs": {
        "enabled": true,
        "base_url": "https://data.usajobs.gov/api/search",
        "api_key": "",
        "user_agent": "",
        "keywords": [
          "artificial intelligence",
          "machine learning",
          "automation",
          "data scientist",
          "prompt engineer"
        ],
        "results_per_query": 25,
        "note": "USAJOBS labor-demand and role-transition signals (credentials from .env preferred)"
      }
    },
    "weather": {
      "enabled": false,
      "note": "Disabled for AI job-risk mode"
    },
    "social": {
      "enabled": true,
      "pushshift": {
        "enabled": true,
        "base_url": "https://api.pushshift.io/reddit/search/submission/",
        "fallback_urls": [
          "https://api.pullpush.io/reddit/search/submission/"
        ],
        "subreddits": ["jobs", "careerguidance", "cscareerquestions", "datascience"],
        "keywords": ["AI layoffs", "job displacement", "automation", "hiring freeze", "reskilling"],
        "max_results_per_query": 25,
        "days_back": 7,
        "note": "Social sentiment about AI and jobs"
      },
      "youtube": {
        "enabled": true,
        "api_key": "YOUR_YOUTUBE_API_KEY",
        "keywords": ["AI replacing jobs", "artificial intelligence jobs", "automation workforce", "AI job displacement"],
        "max_results": 50,
        "note": "Comments from AI/jobs impact videos - novel data source for conference papers",
        "order": "relevance"
      },
      "mastodon": {
        "enabled": true,
        "instances": ["fosstodon.org", "techhub.social", "mstdn.social"],
        "keywords": ["AI jobs", "automation", "tech layoffs", "artificial intelligence", "hiring freeze"],
        "hashtags": ["ai", "jobs", "automation", "techcommunity"],
        "max_results_per_instance": 20,
        "note": "Decentralized social network - tech community sentiment, no API approval needed"
      },
      "hackernews": {
        "enabled": true,
        "keywords": ["AI jobs", "automation", "tech layoffs", "displacement", "hiring freeze"],
        "max_results": 50,
        "min_comments": 5,
        "note": "Tech worker sentiment on HackerNews - citable, live data, free access"
      }
    }
  },
  "output": {
    "domain": "ai_job_risk",
    "formats": ["json", "csv"],
    "output_dir": "../data/"
  },
  "logging": {
    "level": "INFO",
    "log_file": "data_collection.log"
  }
}
